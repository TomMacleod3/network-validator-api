{% if vendor == "cisco" %}
! Generated Switch Configuration
! Vendor: {{ vendor }}
! Location: {{ location }}

hostname {{ hostname }}

vlan 10
 name USERS

vlan 20
 name VOICE

vlan 30
 name MANAGEMENT

interface Vlan30
 description Management SVI
 ip address {{ ip_address }} 255.255.255.0
 no shutdown

interface GigabitEthernet1/0/1
 description User Access Port
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast

interface GigabitEthernet1/0/2
 description Voice Access Port
 switchport mode access
 switchport access vlan 20
 spanning-tree portfast

interface GigabitEthernet1/0/48
 description Uplink to Core
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30

ip default-gateway 10.0.30.1

snmp-server location {{ location }}
snmp-server contact network-operations@example.com

logging host 10.10.10.10
ntp server 10.10.20.20

line vty 0 4
 transport input ssh
 login local

end

{% elif vendor == "juniper" %}
# Generated Switch Configuration
# Vendor: {{ vendor }}
# Location: {{ location }}

set system host-name {{ hostname }}
set system location {{ location }}

set vlans USERS vlan-id 10
set vlans VOICE vlan-id 20
set vlans MANAGEMENT vlan-id 30

set interfaces irb unit 30 description "Management SVI"
set interfaces irb unit 30 family inet address {{ ip_address }}/24
set vlans MANAGEMENT l3-interface irb.30

set interfaces ge-0/0/1 description "User Access Port"
set interfaces ge-0/0/1 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/1 unit 0 family ethernet-switching vlan members USERS

set interfaces ge-0/0/2 description "Voice Access Port"
set interfaces ge-0/0/2 unit 0 family ethernet-switching interface-mode access
set interfaces ge-0/0/2 unit 0 family ethernet-switching vlan members VOICE

set interfaces ge-0/0/48 description "Uplink to Core"
set interfaces ge-0/0/48 unit 0 family ethernet-switching interface-mode trunk
set interfaces ge-0/0/48 unit 0 family ethernet-switching vlan members [ USERS VOICE MANAGEMENT ]

set routing-options static route 0.0.0.0/0 next-hop 10.0.30.1

set snmp location "{{ location }}"
set snmp contact network-operations@example.com

set system syslog host 10.10.10.10 any any
set system ntp server 10.10.20.20

set system services ssh

{% else %}
Unsupported vendor: {{ vendor }}
{% endif %}